################################################################################
#   EPM configuration file to create the MMC-SERVER package for MacOS Application
#
#   This file is processed by the EPM tool to create a package for installation
#   on  MacOS. The package is used to install the MMC-SERVER application as a
#   MacOS Application bundle in the User's Applications directory. 
#   
#   30 May, 2026 - E M Thornber
#   Created
#
#   Copyright (c) 2026 Model Electronics Railway Group Ltd
################################################################################
#
# Utilities

# Services

# Directories
$appdir=${HOME}/Applications/${appname}.app/Contents
$bindir=${appdir}/MacOS
$resdir=${appdir}/Resources
# Sources
$distdir=distribution
$scripts=InstallAndRun/MacOS

%product Module Management Console Server
%copyright 2026 MERG
%vendor Model Electronics Railway Group Ltd
%license License.txt
%readme README.md
%description User interface to allow management of CBUS and VLCB modules.
%version ${version}
%packager E M Thornber

# Create the application bundle structure and set permissions
d 700 ${usrn} ${usrg} ${HOME}/Applications -
d 755 ${usrn} ${usrg} ${HOME}/Applications/${appname}.app -
d 755 ${usrn} ${usrg} ${appdir} -
d 755 ${usrn} ${usrg} ${bindir} -
d 755 ${usrn} ${usrg} ${resdir} -

f 755 ${usrn} ${usrg} ${appdir}/Info.plist ${scripts}/Info.plist nostrip()

# Wrapper script and bundled js file
f 755 ${usrn} ${usrg} ${bindir}/wrapper.sh ${scripts}/wrapper.sh nostrip()
f 644 ${usrn} ${usrg} ${resdir}/main.js    ${distdir}/app/main.js

d 755 ${usrn} ${usrg} ${resdir}/public -
f 644 ${usrn} ${usrg} ${resdir}/public/favicon.ico public/favicon.ico
f 644 ${usrn} ${usrg} ${resdir}/public/index.html  public/index.html

d 755 ${usrn} ${usrg} ${resdir}/public/css -
f 644 ${usrn} ${usrg} ${resdir}/public/css public/css/*.css

d 755 ${usrn} ${usrg} ${resdir}/public/dummyModule -
f 644 ${usrn} ${usrg} ${resdir}/public/dummyModule public/dummyModule/*.html

d 755 ${usrn} ${usrg} ${resdir}/public/fonts -
f 644 ${usrn} ${usrg} ${resdir}/public/fonts public/fonts/*.woff
f 644 ${usrn} ${usrg} ${resdir}/public/fonts public/fonts/*.woff2

d 755 ${usrn} ${usrg} ${resdir}/public/icons -
f 644 ${usrn} ${usrg} ${resdir}/public/icons public/icons/*.png

d 755 ${usrn} ${usrg} ${resdir}/public/img -
f 644 ${usrn} ${usrg} ${resdir}/public/img public/img/*.png

# Front-end resources
d 755 ${usrn} ${usrg} ${resdir}/public/js -
f 644 ${usrn} ${usrg} ${resdir}/public/js public/js/*.js

d 755 ${usrn} ${usrg} ${resdir}/views -
f 644 ${usrn} ${usrg} ${resdir}/views views/*.jade

d 755 ${usrn} ${usrg} ${resdir}/VLCB-server -
d 755 ${usrn} ${usrg} ${resdir}/VLCB-server/config -
f 644 ${usrn} ${usrg} ${resdir}/VLCB-server/config VLCB-server/config/*.json
d 755 ${usrn} ${usrg} ${resdir}/VLCB-server/config/modules -
f 644 ${usrn} ${usrg} ${resdir}/VLCB-server/config/modules VLCB-server/config/modules/*.json
