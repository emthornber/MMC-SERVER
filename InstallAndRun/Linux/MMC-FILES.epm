################################################################################
#   EPM configuration file to create the MMC-SERVER package for Linux
#
#   This file is processed by the EPM tool to create a package of files for
#   installation on  Linux.
#   
#   11 June, 2026 - E M Thornber
#   Created
#
#   Copyright (c) 2026 Model Electronics Railway Group Ltd
################################################################################
#
# Utilities

# Services

# Directories
$bindir=/usr/local/bin
$resdir=/usr/local/share/${appname}
# Sources
$distdir=distribution/pug
$scripts=InstallAndRun/Linux

%product Module Management Console Server
%copyright 2026 MERG
%vendor Model Electronics Railway Group Ltd
%license License.txt
%readme README.md
%description User interface to allow management of CBUS and VLCB modules.
%version ${version}
%packager E M Thornber

%requires nodejs
%requires npm

# Create the application bundle structure and set permissions
d 755 root root /usr -
d 755 root root /usr/local -
d 755 root root ${bindir} -
d 755 root root /usr/local/share -
d 755 root root ${resdir} -

# Wrapper script, icon and bundled js files
f 755 root root ${bindir}/mmc-server      ${scripts}/mmc-server.sh nostrip()
f 644 root root ${resdir}/index.js        ${distdir}/index.js
f 644 root root ${resdir}/MMCicon-256.png ${scripts}/MMCicon-256.png

d 755 root root ${resdir}/client-dist -
f 644 root root ${resdir}/client-dist/socket.io.min.js ${distdir}/client-dist/socket.io.min.js

d 755 root root ${resdir}/config -
f 644 root root ${resdir}/config ${distdir}/config/*.json
d 755 root root ${resdir}/config/modules -
f 644 root root ${resdir}/config/modules ${distdir}/config/modules/*.json

d 755 root root ${resdir}/logs -

d 755 root root ${resdir}/public -
f 644 root root ${resdir}/public/favicon.ico ${distdir}/public/favicon.ico
f 644 root root ${resdir}/public/index.html  ${distdir}/public/index.html

d 755 root root ${resdir}/public/css -
f 644 root root ${resdir}/public/css ${distdir}/public/css/*.css

d 755 root root ${resdir}/public/dummyModule -
f 644 root root ${resdir}/public/dummyModule ${distdir}/public/dummyModule/*.html

d 755 root root ${resdir}/public/fonts -
f 644 root root ${resdir}/public/fonts ${distdir}/public/fonts/*.woff
f 644 root root ${resdir}/public/fonts ${distdir}/public/fonts/*.woff2

d 755 root root ${resdir}/public/icons -
f 644 root root ${resdir}/public/icons ${distdir}/public/icons/*.png

d 755 root root ${resdir}/public/img -
f 644 root root ${resdir}/public/img ${distdir}/public/img/*.png

# Front-end resources
d 755 root root ${resdir}/public/js -
f 644 root root ${resdir}/public/js ${distdir}/public/js/*.js

d 755 root root ${resdir}/views -
f 644 root root ${resdir}/views ${distdir}/views/*.jade